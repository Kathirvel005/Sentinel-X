# Sentinel-X Environment Configuration
# Snapdragon AI Lab Build & Present Challenge

APP_NAME="Sentinel-X"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"

# Privacy & Security Enforcements
LOCAL_ONLY=true
ALLOW_CLOUD_AI=false
TELEMETRY_ENABLED=false
STORE_RAW_SENSITIVE_DATA=false

# AI Runtime & Snapdragon NPU Acceleration
QNN_ENABLED=false
ONNX_RUNTIME_ENABLED=true
FORCE_CPU_FALLBACK=false
PREFERRED_PROVIDER="auto" # Options: auto, qnn, dml, cpu

# Simulation & Benchmarking Mode
DEMO_MODE=true
ENABLE_HARDWARE_BENCHMARK=true

# Database
DATABASE_URL="sqlite:///./sentinel.db"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
